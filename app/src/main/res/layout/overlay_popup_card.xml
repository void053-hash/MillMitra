<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="14dp"
    app:cardBackgroundColor="@color/card_surface"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MillMitra Decode"
                android:textColor="#3730A3"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:textAllCaps="true"
                android:background="@drawable/bg_badge_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <ImageButton
                android:id="@+id/btnCloseCard"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:background="@android:color/transparent"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Close" />
        </RelativeLayout>

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent_amber"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <!-- Decode Mode Input Box & Actions -->
        <LinearLayout
            android:id="@+id/layoutDecodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:minLines="3"
                android:maxLines="6"
                android:hint="Paste or type English message here..."
                android:textColor="@color/text_primary"
                android:textColorHint="#94A3B8"
                android:textSize="14.5sp"
                android:lineSpacingExtra="3dp"
                android:background="@drawable/bg_input_box"
                android:padding="14dp"
                android:gravity="top|start"
                android:scrollbars="vertical"
                android:inputType="textMultiLine|textCapSentences" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/btnPasteClipboard"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="📋 Paste (पेस्ट)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0369A1"
                    android:background="@drawable/bg_vocab_box"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btnClearInput"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="✕ Clear"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:gravity="center"
                    android:layout_marginStart="4dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnTranslateAction"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Decode (अर्थ)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status / Input summary -->
        <TextView
            android:id="@+id/tvInputPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Processing..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="6dp" />

        <!-- Output Result Display & Vocabulary Card -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOutputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp" />

                <!-- Word Meanings / Vocabulary Helper Section -->
                <LinearLayout
                    android:id="@+id/layoutVocabulary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_vocab_box"
                    android:padding="10dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvVocabTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📖 Word Meanings (शब्दार्थ)"
                        android:textColor="#0369A1"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVocabContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- System Google Voice Fallback Button (visible when voice detection needs fallback or quick mic) -->
        <Button
            android:id="@+id/btnLaunchSystemVoice"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="🎙️ Tap to Speak (Google Voice)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btnCopyClipboard"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="@string/copy_to_clipboard"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnShareWhatsApp"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="WhatsApp"
                android:drawableStart="@drawable/ic_whatsapp"
                android:drawablePadding="6dp"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_whatsapp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
